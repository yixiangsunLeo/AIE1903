# ---- Secrets and machine-local state (never commit) ----
.env
.env.*
!.env.example
.ssh/
.secrets/
*.pem
*.p12
*.pfx
*.key
id_rsa*
id_ed25519*
*_ed25519
*_ed25519.pub
.claude/settings.local.json
CLAUDE.local.md
.agent-lock

# ---- NFS junk created by the storage layer (ignore; do not delete) ----
.!!!*

# ---- Python, tools, caches ----
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.cache/

# ---- Editors / OS ----
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# ---- Cursor: only the shared rules are versioned ----
.cursor/*
!.cursor/rules/

# ---- Data: official files stay on the persistent disk (verify with data/checksums.sha256) ----
data/raw/**
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# ---- Run outputs, submissions, weights, logs, backups ----
runs/*
!runs/README.md
submissions/**/*.csv
artifacts/models/*
!artifacts/models/.gitkeep
logs/
backups/
*.log
*.pt
*.pth
*.ckpt
*.safetensors
*.h5
*.onnx
*.pkl
*.joblib

# ---- Archives ----
*.tgz
*.tar.gz
*.zip
